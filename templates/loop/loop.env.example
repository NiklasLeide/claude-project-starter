# loop.env.example — copy to loop.env, source from your loop entrypoint.
# All caps are enforced in code by guards.sh — never by prompt instructions.

# State + logs (one file set per loop; sister loops use their own)
LOOP_STATE_FILE=.loop/state.json
LOOP_INCIDENT_LOG=.loop/incidents.log

# Budgets. Task cap default calibrated from val26 outcomes (~$25 was right;
# $20 was systematically too tight and forced named exceptions).
# Step caps must SUM to the task cap — check with step_budget_gate.
LOOP_BUDGET_USD=25.00
LOOP_STEP_A_USD=15.00
LOOP_STEP_B_USD=7.00
LOOP_STEP_C_USD=3.00

# Hard iteration + wall-clock caps
LOOP_MAX_ITERS=8
LOOP_MAX_SECONDS=7200

# The branch this loop is allowed to run on (branch_guard)
LOOP_BRANCH=loop/my-task

# Optional overrides
# LOOP_LIMIT_PATTERN=rate.?limit|usage limit|429
# LOOP_SCOPE_TARGET_RE=^- (.+): changed, but is not one of the \d+ target entries$
# LOOP_SCOPE_DIRTY_RE=^- unexpected modified tracked file: (.+)$
