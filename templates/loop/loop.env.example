# loop.env.example — copy to loop.env next to run-loop.sh, adjust, run
# scripts/loop/run-loop.sh from the repo root.
# All caps are enforced in code by guards.sh — never by prompt instructions.

# State + logs (one file set per loop; sister loops use their own)
LOOP_STATE_FILE=.loop/state.json
LOOP_INCIDENT_LOG=.loop/incidents.log

# Budgets. Task cap default calibrated from val26 outcomes (~$25 was right;
# $20 was systematically too tight and forced named exceptions).
# Step caps must SUM to the task cap — enforced by step_budget_gate.
LOOP_BUDGET_USD=25.00
LOOP_STEP_DRAFT_USD=18.00
LOOP_STEP_FIX_USD=7.00

# Model routing (v3 cost principle): expensive model makes the single
# draft, cheap model runs the one fix round. See DEC-008 for the defaults.
LOOP_MODEL_DRAFT=claude-opus-4-8
LOOP_MODEL_FIX=claude-haiku-4-5-20251001

# Wall-clock cap for the whole run
LOOP_MAX_SECONDS=7200

# The branch this loop is allowed to run on (branch_guard)
LOOP_BRANCH=loop/my-task

# Deterministic verification, zero tokens. The loop's exit condition.
LOOP_VALIDATE_CMD="node scripts/loop/validate-example.js"

# Prompt skeletons (fill in the {{PLACEHOLDERS}} for your task first)
# LOOP_PROMPT_DRAFT=scripts/loop/prompts/worker-draft.md
# LOOP_PROMPT_FIX=scripts/loop/prompts/worker-fix.md

# Optional overrides
# LOOP_CLAUDE_BIN=claude            # the guard tests point this at a stub
# LOOP_WORKER_TOOLS=Read,Write,Edit,Grep,Glob,WebSearch,WebFetch
# LOOP_RETRY_MAX=3
# LOOP_RETRY_BACKOFF=60
# LOOP_LIMIT_PATTERN=rate.?limit|usage limit|429
# LOOP_SCOPE_TARGET_RE=^- (.+): changed, but is not one of the \d+ target entries$
# LOOP_SCOPE_DIRTY_RE=^- unexpected modified tracked file: (.+)$
